# Ignore everything by default
*

# Un-ignore tracked files and directories
!.gitattributes
!.gitignore
!CLAUDE.md

# Un-ignore agents/ and all its contents
!agents/
!agents/**

# Un-ignore commands/ and all its contents
!commands/
!commands/**

# Un-ignore dreamers/ refs and templates only
!dreamers/
!dreamers/refs/
!dreamers/refs/**
!dreamers/templates/
!dreamers/templates/**
